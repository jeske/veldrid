<!--
  AN.Veldrid.Build.props - Veldrid Library Build Configuration

  This file is explicitly imported by Veldrid library projects (not auto-discovered like Directory.Build.props).
  This allows users to create their own Directory.Build.props for overrides without conflicting with
  Veldrid's internal build settings.

  NOT auto-discovered — must be explicitly imported via:
    <Import Project="../../AN.Veldrid.Build.props" />
  or similar relative path from the importing .csproj file.

  Note: UseLocalVeldrid is controlled by the user via Directory.Build.props, not here.
-->
<Project>

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RepositoryRootDirectory>$(MSBuildThisFileDirectory)</RepositoryRootDirectory>
    <BinDir>$(RepositoryRootDirectory)bin</BinDir>
    <OutputPath>$([System.IO.Path]::GetFullPath('$(RepositoryRootDirectory)bin\$(Configuration)'))\$(MSBuildProjectName)</OutputPath>
    <PackageOutputPath>$(BinDir)\Packages\$(Configuration)</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Dependency versions — edit here, all projects pick them up -->
    <ANCodeAnalyzersVersion>0.1.13</ANCodeAnalyzersVersion>
    <VorticeWindowsVersion>2.4.2</VorticeWindowsVersion>
  </PropertyGroup>

  <!-- ArtificialNecessity.CodeAnalyzers — analyzer package.
       EnforceExplicitEnumValues defaults to none — projects opt in explicitly. -->
  <PropertyGroup>
    <EnforceExplicitEnumValues Condition="'$(EnforceExplicitEnumValues)' == ''">none</EnforceExplicitEnumValues>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ArtificialNecessity.CodeAnalyzers" Version="$(ANCodeAnalyzersVersion)" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright 2024 (c) Eric Mellino and Veldrid contributors. All rights reserved.</Copyright>
    <Authors>Eric Mellino, ppy Pty Ltd</Authors>
    <RepositoryUrl>https://github.com/ppy/veldrid</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <!-- Disable packages.lock.json generation (enabled by default in .NET 10 preview SDK) -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- ══════════════════════════════════════════════════════════════════════
       Local NuGet feed: set LOCAL_NUGET_REPO env var to deploy packages
       after 'dotnet pack'. Only affects projects with IsPackable=true.
       Use cmd/publish-local.ps1 to build+pack+deploy in one step.
       ══════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <LocalNuGetFeedPath>$(LOCAL_NUGET_REPO)</LocalNuGetFeedPath>
  </PropertyGroup>

  <!-- Deploy .nupkg to local NuGet feed after pack.
       Uses @(NuGetPackOutput) populated by the Pack target — this contains the exact
       path to the .nupkg file, avoiding NuGet version normalization issues and
       accidental glob matches on sub-packages (e.g., Veldrid.ImGui matching Veldrid.*). -->
  <Target Name="DeployToLocalNuGet" AfterTargets="Pack" Condition="'$(LocalNuGetFeedPath)' != ''">
    <MakeDir Directories="$(LocalNuGetFeedPath)" Condition="!Exists('$(LocalNuGetFeedPath)')" />
    <ItemGroup>
      <_PackagesToDeploy Include="@(NuGetPackOutput)" Condition="'%(Extension)' == '.nupkg'" />
    </ItemGroup>
    <Copy SourceFiles="@(_PackagesToDeploy)"
          DestinationFolder="$(LocalNuGetFeedPath)"
          OverwriteReadOnlyFiles="true" />
    <Message Importance="High" Text="$(PackageId): Deployed %(Filename)%(Extension) to $(LocalNuGetFeedPath)"
             Condition="'@(_PackagesToDeploy)' != ''" />
  </Target>

  <!-- ══════════════════════════════════════════════════════════════════════
       Timestamp-based versioning (v2). Every build gets a unique version
       automatically — no version.json, no generated files, no scripts.

       Format:
         AssemblyVersion      = {major}.{YYMM}.{DDHH}.{mmss}   (ushort-constrained)
         FileVersion          = (same as AssemblyVersion)
         Version/PackageVersion = {major}.{YYMMDD}.{HHmmss}    (NuGet, human-readable)
         InformationalVersion = {AssemblyVersion}-{MACHINE}+g{gitshort}

       Example (2026-05-25 20:02:07 local):
         AssemblyVersion:      5.2605.2520.0207
         Version/PackageVersion: 5.260525.200207
         InformationalVersion: 5.2605.2520.0207-WORKHORSE+ga1b2c3d

       All timestamps are LOCAL TIME. Each segment stays ≤ 65535.
       Just 'dotnet build' — zero ceremony.
       Scripts pass /p:_BuildYYMM, /p:_BuildDDHH, etc. to lock the timestamp
       across all projects in a multi-project build. If not provided, each
       project computes its own (fine for single-project builds).
       ══════════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <VeldridMajorVersion>5</VeldridMajorVersion>
    <!-- AssemblyVersion segments (ushort-constrained, split timestamp).
         Only computed if not already provided via /p: from build scripts. -->
    <_BuildYYMM Condition="'$(_BuildYYMM)' == ''">$([System.DateTime]::Now.ToString("yyMM"))</_BuildYYMM>
    <_BuildDDHH Condition="'$(_BuildDDHH)' == ''">$([System.DateTime]::Now.ToString("ddHH"))</_BuildDDHH>
    <_Buildmmss Condition="'$(_Buildmmss)' == ''">$([System.DateTime]::Now.ToString("mmss"))</_Buildmmss>
    <VersionPrefix>$(VeldridMajorVersion).$(_BuildYYMM).$(_BuildDDHH).$(_Buildmmss)</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <!-- PackageVersion segments (NuGet, no ushort constraint — full date+time).
         Only computed if not already provided via /p: from build scripts. -->
    <_BuildYYMMDD Condition="'$(_BuildYYMMDD)' == ''">$([System.DateTime]::Now.ToString("yyMMdd"))</_BuildYYMMDD>
    <_BuildHHmmss Condition="'$(_BuildHHmmss)' == ''">$([System.DateTime]::Now.ToString("HHmmss"))</_BuildHHmmss>
    <Version>$(VeldridMajorVersion).$(_BuildYYMMDD).$(_BuildHHmmss)</Version>
  </PropertyGroup>

  <!-- Suppress SDK's automatic SourceRevisionId — we handle git hash ourselves -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Git short hash resolved at build time -->
  <Target Name="_ResolveGitHash" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;BeforeBuild">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortHash" />
    </Exec>
    <PropertyGroup>
      <_GitShortHash Condition="'$(_GitShortHash)' == ''">unknown</_GitShortHash>
      <InformationalVersion>$(VersionPrefix)-$([System.Environment]::MachineName)+g$(_GitShortHash)</InformationalVersion>
    </PropertyGroup>
    <Message Importance="High" Text="$(MSBuildProjectName): version $(VersionPrefix)" />
  </Target>

  <!-- For packable projects, set PackageVersion = Version (3-segment for NuGet) -->
  <Target Name="_SetPackageVersion"
          BeforeTargets="GenerateNuspecDependencies;GetPackageVersionInfo;Pack"
          Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <PackageVersion>$(Version)</PackageVersion>
    </PropertyGroup>
  </Target>

</Project>