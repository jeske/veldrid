<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\AN.Veldrid.Build.props" />

  <PropertyGroup Label="Nuget">
    <PackageId>ArtificialNecessity.Veldrid.ImGui</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DocumentationFile Condition="'$(Configuration)' == 'Release'">$(BinDir)/$(AssemblyName).xml</DocumentationFile>
    <RootNamespace>Veldrid</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-tool sources and local output trees are not renderer sources. -->
    <Compile Remove="Scripts\**;obj\**;bin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.90.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veldrid\Veldrid.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Description>ImGui integration for Veldrid. Provides a simple interface for rendering and interacting with ImGui.NET.</Description>
    <PackageTags>3D Graphics Direct3D DirectX Vulkan OpenGL Metal Core Standard Game ImGui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- D10: the one shader artefact. Recompile with Scripts/CompileShaders after editing Shaders/Source. -->
    <EmbeddedResource Include="Shaders\Compiled\ImGui.vdshader" LogicalName="Veldrid.ImGui.Shaders.ImGui.vdshader" />
    <None Include="Shaders\Source\**;Shaders\Compiled\ImGui.interface.json" />
  </ItemGroup>
</Project>
